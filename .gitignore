# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# --- Python ---
.venv/
.venv-ragas/          # Phase 8: RAGAS pins conflict with the app's langchain range
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Data artifacts (regenerated by `make ingest`) ---
data/processed/
data/chroma*/
data/qdrant*/
*.duckdb
*.sqlite3

# --- Model caches ---
.cache/
models/

# --- Eval / run outputs ---
*.log
evals/**/results/
promptfoo_results.json
.promptfoo/

# Phase 8 eval artefacts ARE committed: the reports are the deliverable, and a
# reviewer must be able to see the numbers without re-running a paid eval.
!evals/promptfoo/results.json
!evals/ragas/results/
!evals/ragas/results/*
evals/ragas/results/*.csv.tmp

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
