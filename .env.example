# ==============================================================================
# Enterprise Knowledge Assistant — environment template
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. NEVER commit real credentials.
# Verify everything works with:           python scripts/check_env.py
# ==============================================================================

# --- 1. OpenRouter (LLM gateway) ---------------------------------------------
# Get: https://openrouter.ai -> sign in -> Keys -> Create Key
# Format: sk-or-v1-...   Requires credit on the account.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_FAST_MODEL=openai/gpt-4o-mini
LLM_SMART_MODEL=openai/gpt-4o

# --- 2. Qdrant Cloud (vector store + semantic cache) -------------------------
# Get: https://cloud.qdrant.io -> create free cluster -> API Keys -> Create
# URL format: https://xxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=acme_docs
QDRANT_CACHE_COLLECTION=acme_cache

# --- 3. Langfuse Cloud (observability) ---------------------------------------
# Get: https://cloud.langfuse.com -> new project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- 4. Tavily (web search tool) ---------------------------------------------
# Get: https://tavily.com -> sign up -> dashboard
# Format: tvly-...   1,000 free searches/month.
TAVILY_API_KEY=

# --- 5. Neo4j (local Docker; nothing to sign up for) -------------------------
# Ports 7475/7688 are used to avoid colliding with any other local Neo4j.
# Choose any password; it must match docker-compose.yml.
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- App settings -------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
CHUNK_SIZE=300
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
CACHE_SIMILARITY_THRESHOLD=0.95
